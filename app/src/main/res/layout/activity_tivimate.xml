<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Menu vertical (masquable) -->
        <LinearLayout
            android:id="@+id/nav_panel"
            android:layout_width="176dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MLTV"
                android:textColor="?attr/accentColor"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginBottom="14dp"
                android:layout_marginStart="6dp" />

            <TextView android:id="@+id/nav_search" style="@style/TiviNav" android:text="Recherche" />
            <TextView android:id="@+id/nav_tv" style="@style/TiviNav" android:text="TV" />
            <TextView android:id="@+id/nav_films" style="@style/TiviNav" android:text="Films" />
            <TextView android:id="@+id/nav_series" style="@style/TiviNav" android:text="Séries" />
            <TextView android:id="@+id/nav_list" style="@style/TiviNav" android:text="Ma liste" />
            <TextView android:id="@+id/nav_settings" style="@style/TiviNav" android:text="Paramètres" />
        </LinearLayout>

        <!-- Bouquets (figé) -->
        <LinearLayout
            android:id="@+id/cat_panel"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/field_bg"
                android:padding="8dp"
                android:hint="Rechercher…"
                android:textColorHint="@color/muted"
                android:textColor="@color/txt"
                android:textSize="13sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_cats"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Chaînes (figé) + grille EPG (défilable) -->
        <LinearLayout
            android:id="@+id/grid_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Ligne d'en-tête : coin figé + frise horaire défilable -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_grid_title"
                    android:layout_width="210dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/txt"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <com.marco.mltv.SyncHScroll
                    android:id="@+id/header_scroll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:focusable="false"
                    android:descendantFocusability="blocksDescendants">

                    <LinearLayout
                        android:id="@+id/header_cells"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp" />
                </com.marco.mltv.SyncHScroll>
            </LinearLayout>

            <!-- Corps : colonne chaînes figée + grille défilable -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_channels"
                    android:layout_width="210dp"
                    android:layout_height="match_parent" />

                <com.marco.mltv.SyncHScroll
                    android:id="@+id/body_scroll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_epg"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent" />
                </com.marco.mltv.SyncHScroll>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
